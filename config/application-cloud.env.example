# Real cloud production example.
# Copy to a non-tracked env file, for example config/application-cloud.env.

# Public HTTPS URL exposed to users. Do not include a trailing slash.
PUBLIC_BASE_URL=https://asta.example.com

# Cloudflare Tunnel token. Create it in Cloudflare Zero Trust.
CLOUDFLARE_TUNNEL_TOKEN=

# Application settings
ADMIN_PIN=
APP_CREDITS_TOTAL=500
APP_RANDOM_MODE=ROLE
APP_ROSTER_PORTIERI=3
APP_ROSTER_DIFENSORI=8
APP_ROSTER_CENTROCAMPISTI=8
APP_ROSTER_ATTACCANTI=6

# Neon/Postgres application database
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_JDBC_PARAMS=?sslmode=require

# Keycloak database, local to the VPS/container host
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=

# Keycloak admin and backend client secret
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_BACKEND_SECRET=
