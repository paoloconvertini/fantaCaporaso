# Esecuzione pubblica dal Mac tramite Cloudflare Tunnel.
# Copiare in config/application-prod.local.env e usare insieme ai due Compose.

# Public HTTPS URL exposed to users. Do not include a trailing slash.
PUBLIC_BASE_URL=https://asta.example.com

# Cloudflare Tunnel token. Create it in Cloudflare Zero Trust.
CLOUDFLARE_TUNNEL_TOKEN=

# Application settings
ADMIN_PIN=
JWT_SECRET=
JWT_EXPIRATION_SECONDS=28800
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
APP_CREDITS_TOTAL=500
APP_RANDOM_MODE=ROLE
APP_ROSTER_PORTIERI=3
APP_ROSTER_DIFENSORI=8
APP_ROSTER_CENTROCAMPISTI=8
APP_ROSTER_ATTACCANTI=6

# PostgreSQL locale nello stack docker-compose.prod.yml
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_JDBC_PARAMS=
