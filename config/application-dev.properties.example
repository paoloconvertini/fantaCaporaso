# Development properties loaded by Quarkus dev mode.
# Copy to config/application-dev.properties and fill local secrets.

# Quarkus HTTP
QUARKUS_HTTP_HOST=0.0.0.0
QUARKUS_HTTP_PORT=8080

# CORS
CORS_ORIGINS=*

# Application settings
ADMIN_PIN=
APP_CREDITS_TOTAL=500
APP_RANDOM_MODE=ROLE
APP_ROSTER_PORTIERI=3
APP_ROSTER_DIFENSORI=8
APP_ROSTER_CENTROCAMPISTI=8
APP_ROSTER_ATTACCANTI=6

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fantasta
POSTGRES_USER=
POSTGRES_PASSWORD=

# OIDC / Keycloak
KEYCLOAK_BACKEND_SECRET=
OIDC_AUTH_SERVER_URL=
OIDC_TOKEN_ISSUER=any
QUARKUS_OIDC_CLIENT_ID=fantasta-backend
QUARKUS_OIDC_TLS_VERIFICATION=none
KEYCLOAK_ADMIN_URL=
KEYCLOAK_ADMIN_REALM=fantasta
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=

# Optional player import override
PLAYERS_FILE=
