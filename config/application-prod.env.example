# Production environment example.
# Copy to a non-tracked .env file and fill values for the target deployment.

# Quarkus HTTP
QUARKUS_HTTP_HOST=0.0.0.0
QUARKUS_HTTP_PORT=8080

# CORS
CORS_ORIGINS=http://localhost:8088,https://asta.fantacaporaso.it

# Application settings
ADMIN_PIN=
JWT_SECRET=
JWT_EXPIRATION_SECONDS=28800
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
APP_CREDITS_TOTAL=500
APP_RANDOM_MODE=ROLE
APP_ROSTER_PORTIERI=3
APP_ROSTER_DIFENSORI=8
APP_ROSTER_CENTROCAMPISTI=8
APP_ROSTER_ATTACCANTI=6

# Database
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_JDBC_PARAMS=

# Optional player import override
PLAYERS_FILE=
