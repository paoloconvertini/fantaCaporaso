# Local production-like Docker Compose example.
# Copy to .env at repository root before running docker compose.

PUBLIC_HTTP_PORT=8088

POSTGRES_DB=fantasta
POSTGRES_USER=fantasta
POSTGRES_PASSWORD=change-me

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

KEYCLOAK_BACKEND_SECRET=change-me

# For local prod-like test through http://localhost:8088 keep issuer relaxed.
# For real HTTPS production use the public issuer, for example:
# OIDC_TOKEN_ISSUER=https://your-domain.example/auth/realms/fantasta
OIDC_TOKEN_ISSUER=any

CORS_ORIGINS=*
ADMIN_PIN=1234
APP_CREDITS_TOTAL=500
APP_RANDOM_MODE=ROLE
APP_ROSTER_PORTIERI=3
APP_ROSTER_DIFENSORI=8
APP_ROSTER_CENTROCAMPISTI=8
APP_ROSTER_ATTACCANTI=6
