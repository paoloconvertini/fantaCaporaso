# Local production-like Docker Compose example.
# Copy to .env at repository root before running docker compose.

PUBLIC_HTTP_PORT=8088
PUBLIC_BIND_ADDRESS=127.0.0.1

# Richiesto solo quando si aggiunge docker-compose.cloud.yml.
CLOUDFLARE_TUNNEL_TOKEN=

POSTGRES_DB=fantasta
POSTGRES_USER=fantasta
POSTGRES_PASSWORD=change-me

JWT_SECRET=change-me-with-a-long-random-value
JWT_EXPIRATION_SECONDS=28800
BOOTSTRAP_ADMIN_USERNAME=paolo
BOOTSTRAP_ADMIN_PASSWORD=change-me-with-a-strong-password

CORS_ORIGINS=http://localhost:8088,/https:\/\/[a-zA-Z0-9-]+\.trycloudflare\.com/,/http:\/\/(10\.[0-9.]+|192\.168\.[0-9.]+|172\.(1[6-9]|2[0-9]|3[01])\.[0-9.]+):8088/
ADMIN_PIN=1234
APP_CREDITS_TOTAL=500
APP_RANDOM_MODE=ROLE
APP_ROSTER_PORTIERI=3
APP_ROSTER_DIFENSORI=8
APP_ROSTER_CENTROCAMPISTI=8
APP_ROSTER_ATTACCANTI=6
