# Development environment example.
# Copy to a non-tracked .env file and fill values for the current machine.

# Quarkus HTTP
QUARKUS_HTTP_HOST=0.0.0.0
QUARKUS_HTTP_PORT=8080

# CORS
CORS_ORIGINS=*

# Application settings
ADMIN_PIN=
JWT_SECRET=
JWT_EXPIRATION_SECONDS=28800
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
APP_CREDITS_TOTAL=500
APP_RANDOM_MODE=ROLE
APP_ROSTER_PORTIERI=3
APP_ROSTER_DIFENSORI=8
APP_ROSTER_CENTROCAMPISTI=8
APP_ROSTER_ATTACCANTI=6
APP_ENVIRONMENT=dev
# Blocco intenzionale: DEV genera soltanto un'anteprima locale e non pubblica mai.
AUCTION_ARCHIVE_PUBLISH_ENABLED=false
AUCTION_ARCHIVE_OUTPUT_DIR=backend/target/auction-archive
AUCTION_ARCHIVE_LANDING_DIR=landing-page

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fantasta_dev
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5432

# Optional player import override
PLAYERS_FILE=
